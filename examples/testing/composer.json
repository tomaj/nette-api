{
    "name": "acme/testing-api",
    "description": "Unit tests of tomaj/nette-api handlers, params, outputs and authorization with PHPUnit",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "tomaj/nette-api": "^3.5",
        "nette/bootstrap": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
