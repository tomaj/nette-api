{
    "name": "tomaj/nette-api",
    "description": "Nette api",
    "license": "MIT",
    "keywords": [
        "nette",
        "api"
    ],
    "authors": [
        {
            "name": "Tomas Majer",
            "email": "tomasmajer@gmail.com",
            "homepage": "http://www.tomaj.sk/"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-session": "*",
        "ext-filter": "*",
        "nette/application": "^3.2",
        "nette/http": "^3.3",
        "tracy/tracy": "^2.10",
        "league/fractal": "^0.21",
        "tomaj/nette-bootstrap-form": "^2.1",
        "justinrainbow/json-schema": "^6.0",
        "latte/latte": "^3.0.20"
    },
    "require-dev": {
        "nette/di": "^3.2",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "symfony/yaml": "^7.4.12 || ^8.0.12",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.2",
        "infection/infection": "^0.31 || ^0.35"
    },
    "conflict": {
        "marc-mabe/php-enum": "<4.4"
    },
    "autoload": {
        "psr-4": {
            "Tomaj\\NetteApi\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tomaj\\NetteApi\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "coverage": "XDEBUG_MODE=develop,coverage phpunit --coverage-clover=build/logs/clover.xml --coverage-html=build/coverage --coverage-text",
        "phpstan": "phpstan analyse",
        "rector": "rector process --dry-run",
        "cs": "phpcs",
        "infection": "infection"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
