{
    "openapi": "3.0.0",
    "info": {
        "version": "2",
        "title": "Nette API"
    },
    "servers": [
        {
            "url": "https://example.com"
        }
    ],
    "components": {
        "schemas": {
            "User": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "email": {
                        "type": "string",
                        "nullable": true
                    }
                }
            },
            "ErrorWrongInput": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": [
                            "error"
                        ]
                    },
                    "message": {
                        "type": "string"
                    }
                },
                "required": [
                    "status",
                    "message"
                ]
            },
            "ErrorUnauthorized": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": [
                            "error"
                        ]
                    },
                    "message": {
                        "type": "string",
                        "enum": [
                            "Authorization header HTTP_Authorization is not set",
                            "Authorization header contains invalid structure",
                            "Authorization header doesn't contain bearer token",
                            "API key is not set"
                        ]
                    }
                },
                "required": [
                    "status",
                    "message"
                ]
            },
            "InternalServerError": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": [
                            "error"
                        ]
                    },
                    "message": {
                        "type": "string",
                        "enum": [
                            "Internal server error"
                        ]
                    }
                },
                "required": [
                    "status",
                    "message"
                ]
            }
        }
    },
    "paths": {
        "/api/v2/ping": {
            "get": {
                "summary": "",
                "description": "",
                "tags": [],
                "responses": {
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json; charset=utf-8": {
                                "schema": {
                                    "$ref": "#/components/schemas/InternalServerError"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "",
                        "content": {
                            "application/json; charset=utf-8": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v2/users": {
            "get": {
                "summary": "List users",
                "description": "Returns paginated list of users",
                "tags": [
                    "users",
                    "listing"
                ],
                "deprecated": true,
                "parameters": [
                    {
                        "name": "status",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "active",
                                "blocked"
                            ]
                        },
                        "description": "User status\n * `active` - Active users\n * `blocked` - Blocked users"
                    },
                    {
                        "name": "order",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "asc",
                                "desc"
                            ]
                        },
                        "example": "asc"
                    },
                    {
                        "name": "ids[]",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "example": "1"
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "description": "Page number"
                    },
                    {
                        "name": "session",
                        "in": "cookie",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "description": "Session id"
                    }
                ],
                "responses": {
                    "400": {
                        "description": "Bad request",
                        "content": {
                            "application/json; charset=utf-8": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorWrongInput"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json; charset=utf-8": {
                                "schema": {
                                    "$ref": "#/components/schemas/InternalServerError"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "List of users",
                        "content": {
                            "application/json; charset=utf-8": {
                                "example": {
                                    "users": [
                                        {
                                            "id": 1,
                                            "email": null
                                        }
                                    ],
                                    "next": null
                                },
                                "schema": {
                                    "oneOf": [
                                        {
                                            "type": "object",
                                            "properties": {
                                                "users": {
                                                    "type": "array",
                                                    "items": {
                                                        "$ref": "#/components/schemas/User"
                                                    }
                                                },
                                                "next": {
                                                    "type": "string",
                                                    "nullable": true
                                                }
                                            }
                                        },
                                        {
                                            "type": "string"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "206": {
                        "description": "Partial",
                        "content": {
                            "application/json; charset=utf-8": {
                                "schema": {
                                    "type": "object"
                                },
                                "examples": {
                                    "first": {
                                        "a": 1
                                    },
                                    "second": {
                                        "b": 2
                                    }
                                }
                            }
                        }
                    },
                    "302": {
                        "description": "Redirect",
                        "headers": {
                            "Location": {
                                "description": "Redirect to new listing",
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v2/docs/open-api": {
            "get": {
                "summary": "",
                "description": "Open API",
                "tags": [
                    "openapi"
                ],
                "parameters": [
                    {
                        "name": "format",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "json",
                                "yaml"
                            ]
                        },
                        "description": "Response format"
                    }
                ],
                "responses": {
                    "400": {
                        "description": "Bad request",
                        "content": {
                            "application/json; charset=utf-8": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorWrongInput"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json; charset=utf-8": {
                                "schema": {
                                    "$ref": "#/components/schemas/InternalServerError"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
